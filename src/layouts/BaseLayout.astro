---
import type { Lang } from "../i18n/translations";

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  alternates?: { hreflang: string; href: string }[];
}

const { title, description, lang = "de", alternates = [] } = Astro.props;

const site = Astro.site ?? new URL("https://kopfsache-walhorn.be");
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL("/og-image.jpg", site).href;
const ogLocale = lang === "fr" ? "fr_BE" : "de_BE";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- Vorschau, wenn der Link in WhatsApp, Facebook & Co. geteilt wird -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kopfsache" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />

    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@300&family=Oxygen:wght@300;400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    /* Kopfsache: Weiß + Beige, Gold aus dem Logo, eine Schrift (Oxygen) */
    --white: #ffffff;
    --beige: #f4ebd6;
    --beige-line: #e2d5b6;
    --gold: #a8873f;        /* Linien, Rahmen, Icons */
    --gold-strong: #8a6d2f; /* Knopf-Hintergrund (weiße Schrift 4,9:1) */
    --gold-text: #7a5f24;   /* goldene Schrift (6:1 auf Weiß, 5:1 auf Beige) */
    --ink: #2b2a28;
    --ink-soft: #3f3c37;
    --muted: #6b6458;

    --font-sans: "Oxygen", "Segoe UI", system-ui, sans-serif;
    --font-serif: var(--font-sans);

    --container: 1120px;
    --section-y: clamp(64px, 8vw, 96px);
    --gutter: 24px;

    /* alte Namen, damit Impressum/Datenschutz weiter funktionieren */
    --bg: var(--white);
    --surface: var(--white);
    --surface-muted: var(--beige);
    --ink-muted: var(--muted);
    --sage: var(--gold-text);
    --line: var(--beige-line);
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }

  /* Seite darf nie seitlich wackeln (iPhone-Safari): alles, was breiter
     als der Bildschirm wäre, wird abgeschnitten statt verschiebbar */
  html,
  body {
    overflow-x: hidden;
  }
  @supports (overflow: clip) {
    html,
    body {
      overflow-x: clip;
    }
  }

  body {
    margin: 0;
    background: var(--white);
    color: var(--ink);
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: 17px;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }

  h1,
  h2,
  h3 {
    font-weight: 400;
    color: var(--ink);
    text-wrap: balance;
  }

  strong,
  b {
    font-weight: 700;
  }

  img {
    max-width: 100%;
    display: block;
  }

  a {
    color: var(--gold-text);
    text-decoration: none;
  }
  a:hover {
    color: var(--ink);
  }

  :focus-visible {
    outline: 2px solid var(--gold-strong);
    outline-offset: 3px;
  }

  /* Abschnitte: einheitlicher Rhythmus */
  .section {
    padding: var(--section-y) var(--gutter);
  }
  .section-beige {
    background: var(--beige);
  }
  .container {
    max-width: var(--container);
    margin: 0 auto;
  }
  .section-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
    margin: 0 auto clamp(40px, 5vw, 56px);
  }
  .section-head h2 {
    margin: 0;
    font-size: clamp(32px, 4vw, 44px);
    line-height: 1.15;
    letter-spacing: 0.01em;
  }
  .section-head p {
    margin: 0;
    max-width: 40em;
    text-wrap: balance;
    font-size: 15px;
    color: var(--muted);
  }
  .divider {
    display: block;
    width: 80px;
    height: 1px;
    background: var(--gold);
  }

  /* Knöpfe */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 12px 26px;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border: 1px solid var(--gold);
    border-radius: 0;
    cursor: pointer;
    transition: background 160ms ease, color 160ms ease, border-color 160ms ease;
    white-space: nowrap;
  }
  .btn-outline {
    background: transparent;
    color: var(--gold-text);
  }
  .btn-outline:hover {
    background: var(--gold-strong);
    border-color: var(--gold-strong);
    color: var(--white);
  }
  .btn-solid {
    background: var(--gold-strong);
    border-color: var(--gold-strong);
    color: var(--white);
  }
  .btn-solid:hover {
    background: var(--gold-text);
    border-color: var(--gold-text);
    color: var(--white);
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    * {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }

  .wrap {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px;
  }
</style>
