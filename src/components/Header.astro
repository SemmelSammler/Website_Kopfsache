---
import LogoMark from "./LogoMark.astro";
import { useTranslations, altPath, type Lang } from "../i18n/translations";

interface Props {
  lang: Lang;
  /** Auf Unterseiten zeigen die Anker auf die Startseite */
  home?: boolean;
}

const { lang, home = true } = Astro.props;
const t = useTranslations(lang);
const base = home ? "" : altPath(lang, "/");

const links = [
  { href: `${base}#ueber`, label: t("nav.ueber") },
  { href: `${base}#team`, label: t("nav.team") },
  { href: `${base}#leistungen`, label: t("nav.leistungen") },
  { href: `${base}#preise`, label: t("nav.preise") },
  { href: `${base}#galerie`, label: t("nav.galerie") },
  { href: `${base}#kontakt`, label: t("nav.kontakt") },
];
---

<header class="site-header">
  <div class="header-row">
    <a class="brand" href={home ? "#top" : altPath(lang, "/")} aria-label="Kopfsache – Start">
      <LogoMark width={52} class="brand-logo" />
      <span class="brand-text">
        <span class="brand-name">KOPFSACHE</span>
        <span class="brand-sub">{t("brand.sub")}</span>
      </span>
    </a>

    <button
      class="nav-toggle"
      id="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label={t("nav.menuLabel")}
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
        <line x1="3" y1="7" x2="21" y2="7"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="17" x2="21" y2="17"></line>
      </svg>
    </button>

    <nav class="site-nav" id="site-nav">
      <ul class="nav-links">
        {links.map((l) => <li><a class="nav-link" href={l.href}>{l.label}</a></li>)}
      </ul>
      <div class="nav-actions">
        <span class="lang-switch" role="group" aria-label="Sprache / Langue">
          <a class:list={["lang-link", { active: lang === "de" }]} href={altPath("de", "/")} aria-current={lang === "de" ? "page" : undefined}>DE</a>
          <span class="lang-sep" aria-hidden="true">|</span>
          <a class:list={["lang-link", { active: lang === "fr" }]} href={altPath("fr", "/")} aria-current={lang === "fr" ? "page" : undefined}>FR</a>
        </span>
        <a class="btn btn-outline" href={`${base}#termin`}>{t("nav.termin")}</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const nav = document.getElementById("site-nav");
  toggle?.addEventListener("click", () => {
    const open = nav?.classList.toggle("open");
    toggle.setAttribute("aria-expanded", open ? "true" : "false");
  });
  nav?.querySelectorAll("a[href*='#']").forEach((link) => {
    link.addEventListener("click", () => {
      nav.classList.remove("open");
      toggle?.setAttribute("aria-expanded", "false");
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--white);
    border-bottom: 1px solid var(--beige-line);
  }

  .header-row {
    max-width: 1240px;
    margin: 0 auto;
    padding: 12px var(--gutter);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 32px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--ink);
  }
  .brand:hover {
    color: var(--ink);
  }

  .brand-logo {
    flex: none;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
    line-height: 1.1;
  }

  .brand-name {
    font-family: "Josefin Sans", var(--font-sans);
    font-size: 22px;
    font-weight: 300;
    letter-spacing: 0.22em;
    line-height: 1;
  }

  .brand-sub {
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--gold-text);
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .nav-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .nav-link {
    font-size: 14px;
    font-weight: 400;
    color: var(--gold-text);
    padding: 12px 0;
  }
  .nav-link:hover {
    color: var(--ink);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
  }

  .lang-link {
    color: var(--muted);
    padding: 12px 2px;
    letter-spacing: 0.06em;
  }
  .lang-link.active {
    color: var(--ink);
    font-weight: 700;
  }

  .lang-sep {
    color: var(--beige-line);
  }

  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    background: none;
    border: 1px solid var(--gold);
    color: var(--gold-text);
    cursor: pointer;
  }

  @media (max-width: 1080px) {
    .nav-toggle {
      display: inline-flex;
    }
    .site-nav {
      display: none;
      flex-basis: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
      padding: 8px 0 16px;
      border-top: 1px solid var(--beige-line);
    }
    .site-nav.open {
      display: flex;
    }
    .nav-links {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
    .nav-link {
      display: block;
      padding: 12px 0;
      font-size: 16px;
      border-bottom: 1px solid var(--beige);
    }
    .nav-actions {
      justify-content: space-between;
    }
  }
</style>
