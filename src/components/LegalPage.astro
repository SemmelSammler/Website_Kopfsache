---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import type { Lang } from "../i18n/translations";

interface Props {
  lang: Lang;
  page: "/impressum" | "/datenschutz";
  title: string;
  description: string;
}

const { lang, page, title, description } = Astro.props;
const site = "https://kopfsache-walhorn.be";
const alternates = [
  { hreflang: "de", href: `${site}${page}/` },
  { hreflang: "fr", href: `${site}/fr${page}/` },
  { hreflang: "x-default", href: `${site}${page}/` },
];
---

<BaseLayout title={title} description={description} lang={lang} alternates={alternates}>
  <Header lang={lang} home={false} page={page} />
  <main class="legal">
    <slot />
  </main>
  <Footer lang={lang} divider={false} />
</BaseLayout>

<style>
  .legal {
    max-width: 760px;
    margin: 0 auto;
    padding: var(--section-y) var(--gutter);
  }
  .legal :global(h1) {
    margin: 0 0 32px;
    font-size: clamp(32px, 4vw, 44px);
    line-height: 1.15;
  }
  .legal :global(h2) {
    margin: 40px 0 12px;
    font-size: 20px;
    line-height: 1.3;
  }
  .legal :global(p),
  .legal :global(li) {
    font-size: 16px;
    line-height: 1.8;
  }
  .legal :global(p) {
    margin: 0 0 14px;
  }
  .legal :global(ul) {
    margin: 0 0 14px;
    padding-left: 20px;
  }
  .legal :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }
  .legal :global(.stand) {
    margin-top: 40px;
    font-size: 14px;
    color: var(--muted);
  }
</style>
