---
import { useTranslations, altPath, type Lang } from "../i18n/translations";

interface Props {
  lang: Lang;
  /** Trennlinie oben (auf der Startseite, weil Kontakt direkt darüber auch beige ist) */
  divider?: boolean;
}

const { lang, divider = true } = Astro.props;
const t = useTranslations(lang);
---

<footer class:list={["site-footer", { "no-divider": !divider }]}>
  <div class="footer-inner">
    <div class="social">
      <a href="https://www.instagram.com/dasistalles.kopfsache/" target="_blank" rel="noopener" aria-label="Instagram">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle></svg>
      </a>
      <a href="https://www.facebook.com/Kopfsacheeupen/" target="_blank" rel="noopener" aria-label="Facebook">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v2H8v4h2v8h4v-8h3l1-4h-4V8z"></path></svg>
      </a>
      <a href="https://wa.me/32471886329" target="_blank" rel="noopener" aria-label="WhatsApp">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 20.5l1.4-4.1A8.6 8.6 0 1 1 8.3 19.3z"></path><path d="M9 8.6c.2-.5.6-.6.9-.6h.5c.2 0 .4.1.5.4l.6 1.5c.1.2 0 .5-.1.6l-.5.6c.6 1.2 1.5 2.1 2.7 2.7l.6-.5c.2-.2.4-.2.6-.1l1.5.6c.3.1.4.3.4.5v.5c0 .3-.1.7-.6.9-.6.3-1.7.4-3.5-.7-1.6-1-2.7-2.4-3.3-3.6-.5-1.1-.5-2.2-.2-2.7z" fill="currentColor" stroke="none"></path></svg>
      </a>
    </div>
    <p class="legal">
      <span>© Salon Kopfsache · Walhorn</span>
      <span class="legal-links">
        <a href={altPath(lang, "/impressum")}>{t("footer.impressum")}</a>
        <a href={altPath(lang, "/datenschutz")}>{t("footer.datenschutz")}</a>
      </span>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--beige);
    padding: 0 var(--gutter) 40px;
  }

  .no-divider {
    padding-top: 40px;
  }
  .no-divider .footer-inner {
    border-top: 0;
    padding-top: 0;
  }

  .footer-inner {
    max-width: var(--container);
    margin: 0 auto;
    border-top: 1px solid var(--beige-line);
    padding-top: 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .social {
    display: flex;
    gap: 12px;
  }

  .social a {
    width: 46px;
    height: 46px;
    border: 1px solid var(--ink);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink);
    transition: background 160ms ease, color 160ms ease;
  }
  .social a:hover {
    background: var(--ink);
    color: var(--white);
  }

  .legal {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 28px;
    font-size: 13px;
    color: var(--muted);
  }

  .legal-links {
    display: inline-flex;
    gap: 20px;
  }

  .legal a {
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .legal a:hover {
    color: var(--ink);
  }
</style>
