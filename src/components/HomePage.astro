---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import salonAussen from "../assets/images/salon-aussen.jpg";
import portraitSalon from "../assets/images/portrait-salon.jpg";
import salonEingang from "../assets/images/salon-eingang.jpg";
import bianca from "../assets/images/bianca.jpg";
import lara from "../assets/images/lara.jpg";
import balayageVorher from "../assets/images/balayage-vorher.jpg";
import balayageNachher from "../assets/images/balayage-nachher.jpg";
import bobVorher from "../assets/images/bob-vorher.jpg";
import bobNachher from "../assets/images/bob-nachher.jpg";
import bobNachher2 from "../assets/images/bob-nachher2.jpg";
import { useTranslations, type Lang } from "../i18n/translations";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const PHONE_DISPLAY = "087 76 67 35";
const PHONE_LINK = "tel:+3287766735";
const INSTAGRAM = "https://www.instagram.com/dasistalles.kopfsache/";

const timeline = [
  { year: "2008", label: t("ueber.t1") },
  { year: "2014", label: t("ueber.t2") },
  { year: "2017", label: t("ueber.t3") },
  { year: "2020", label: t("ueber.t4") },
  { year: t("ueber.t5Year"), label: t("ueber.t5") },
];

const team = [
  { name: "Kimberly", role: t("team.kimberly.role"), img: salonAussen, position: "32% 12%" },
  { name: "Bianca", role: t("team.bianca.role"), img: bianca, position: "50% 8%" },
  { name: "Lara", role: t("team.lara.role"), img: lara, position: "50% 25%" },
];

const extras = [
  { title: t("leistungen.herren"), text: t("leistungen.herrenText") },
  { title: t("leistungen.kinder"), text: t("leistungen.kinderText") },
  { title: t("leistungen.anlass"), text: t("leistungen.anlassText") },
  { title: t("leistungen.haus"), text: t("leistungen.hausText") },
];

/**
 * Preise vorübergehend ausgeblendet, bis Kimberly die finale Preisliste
 * bestätigt hat. Zum Wiedereinblenden einfach auf true setzen.
 */
const SHOW_PRICES = false;

const pricesAll = [
  { title: t("preise.damen"), text: t("preise.damenText"), price: t("preise.damenPreis") },
  { title: t("preise.herren"), text: t("preise.herrenText"), price: t("preise.herrenPreis") },
  { title: t("preise.kinder"), text: t("preise.kinderText"), price: t("preise.kinderPreis") },
  { title: t("preise.anlass"), text: t("preise.anlassText"), price: t("preise.aufAnfrage") },
  { title: t("preise.haus"), text: t("preise.hausText"), price: t("preise.aufAnfrage") },
];

const prices = SHOW_PRICES ? pricesAll : pricesAll.map((p) => ({ ...p, price: t("preise.aufAnfrage") }));

const beforeAfter = [
  {
    before: balayageVorher,
    after: balayageNachher,
    beforeAlt: t("galerie.cap1Vorher"),
    afterAlt: t("galerie.cap1Nachher"),
    caption: t("galerie.cap1"),
  },
  {
    before: bobVorher,
    after: bobNachher2,
    beforeAlt: t("galerie.cap2Vorher"),
    afterAlt: t("galerie.cap2Nachher"),
    caption: t("galerie.cap2"),
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "HairSalon",
  name: "Kopfsache",
  url: "https://kopfsache-walhorn.be/",
  image: "https://kopfsache-walhorn.be/og-image.jpg",
  priceRange: "€€",
  telephone: "+32 87 76 67 35",
  email: "kopfsache.info@gmail.com",
  founder: { "@type": "Person", name: "Kimberly Bonni" },
  address: {
    "@type": "PostalAddress",
    streetAddress: "Lindenweg 8",
    postalCode: "4711",
    addressLocality: "Walhorn",
    addressCountry: "BE",
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "09:00",
      closes: "18:00",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: "Saturday",
      opens: "08:00",
      closes: "14:00",
    },
  ],
  sameAs: [INSTAGRAM],
};

const alternates = [
  { hreflang: "de", href: "https://kopfsache-walhorn.be/" },
  { hreflang: "fr", href: "https://kopfsache-walhorn.be/fr/" },
  { hreflang: "x-default", href: "https://kopfsache-walhorn.be/" },
];

const bookingVars = {
  subjectPrefix: t("booking.mailSubject"),
  labelName: t("booking.mailName"),
  labelKontakt: t("booking.mailKontakt"),
  labelLeistung: t("booking.mailLeistung"),
  labelPerson: t("booking.mailPerson"),
  labelTermin: t("booking.mailTermin"),
  flexibel: t("booking.mailFlexibel"),
  labelNachricht: t("booking.mailNachricht"),
  keine: t("booking.mailKeine"),
  thanksTemplate: t("booking.thanks"),
  thanksFallbackName: t("booking.thanksFallbackName"),
  fallbackPrefix: t("booking.fallbackPrefix"),
  fallbackLink: t("booking.fallbackLink"),
  fallbackSuffix: t("booking.fallbackSuffix"),
};
---

<BaseLayout title={t("meta.title")} description={t("meta.description")} lang={lang} alternates={alternates}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div id="top">
    <Header lang={lang} />

    <main>
      <!-- Bild oben -->
      <section class="hero">
        <Image
          src={salonAussen}
          alt={t("hero.imgAlt")}
          class="hero-img"
          widths={[640, 960, 1139]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
        />
        <div class="hero-card">
          <h1>{t("hero.title")}</h1>
          <span class="divider" aria-hidden="true"></span>
          <p>{t("hero.text")}</p>
          <div class="hero-actions">
            <a class="btn btn-solid" href="#termin">{t("booking.title")}</a>
            <a class="btn btn-outline" href={PHONE_LINK}>{PHONE_DISPLAY}</a>
          </div>
        </div>
      </section>

      <!-- Über uns -->
      <section id="ueber" class="section-beige ueber">
        <div class="section-head ueber-head">
          <h2>{t("ueber.title")}</h2>
          <span class="divider" aria-hidden="true"></span>
        </div>
        <div class="ueber-split">
          <Image
            src={portraitSalon}
            alt={t("ueber.imgAlt")}
            class="ueber-img"
            widths={[480, 800]}
            sizes="(max-width: 860px) 100vw, 50vw"
            loading="lazy"
          />
          <div class="ueber-text">
            <svg class="scissors" width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" aria-hidden="true">
              <circle cx="6" cy="6" r="3"></circle>
              <circle cx="6" cy="18" r="3"></circle>
              <line x1="20" y1="4" x2="8.12" y2="15.88"></line>
              <line x1="14.47" y1="14.48" x2="20" y2="20"></line>
              <line x1="8.12" y1="8.12" x2="12" y2="12"></line>
            </svg>
            <p>{t("ueber.p1")}</p>
            <p>{t("ueber.p2")}</p>
            <p class="sign">{t("ueber.sign")}</p>
          </div>
        </div>
        <ol class="timeline container" aria-label={t("ueber.timelineLabel")}>
          {
            timeline.map((step) => (
              <li>
                <span class="year">{step.year}</span>
                <span class="label">{step.label}</span>
              </li>
            ))
          }
        </ol>
      </section>

      <!-- Team -->
      <section id="team" class="section">
        <div class="container">
          <div class="section-head">
            <h2>{t("team.title")}</h2>
            <span class="divider" aria-hidden="true"></span>
          </div>
          <ul class="team-grid">
            {
              team.map((m) => (
                <li class="team-card">
                  <Image
                    src={m.img}
                    alt={m.name}
                    class="team-img"
                    widths={[360, 600]}
                    sizes="(max-width: 860px) 100vw, 33vw"
                    loading="lazy"
                    style={`object-position:${m.position}`}
                  />
                  <h3>{m.name}</h3>
                  <p>{m.role}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- Leistungen -->
      <section id="leistungen" class="section section-beige">
        <div class="container">
          <div class="section-head">
            <h2>{t("leistungen.title")}</h2>
            <span class="divider" aria-hidden="true"></span>
          </div>
          <div class="service-grid">
            <a class="service-card" href="#preise">
              <Image src={bobNachher} alt={t("leistungen.schnittAlt")} class="service-img" widths={[480, 900]} sizes="(max-width: 700px) 100vw, 50vw" loading="lazy" />
              <h3>{t("leistungen.schnitt")}</h3>
              <span class="more">{t("leistungen.more")}</span>
            </a>
            <a class="service-card" href="#preise">
              <Image src={balayageNachher} alt={t("leistungen.farbeAlt")} class="service-img" widths={[480, 900]} sizes="(max-width: 700px) 100vw, 50vw" loading="lazy" />
              <h3>{t("leistungen.farbe")}</h3>
              <span class="more">{t("leistungen.more")}</span>
            </a>
          </div>
          <ul class="extras">
            {
              extras.map((e) => (
                <li>
                  <h3>{e.title}</h3>
                  <p>{e.text}</p>
                </li>
              ))
            }
          </ul>
          <p class="glynt">
            {t("glynt.text")} <strong>GLYNT</strong>.
          </p>
        </div>
      </section>

      <!-- Preise -->
      <section id="preise" class="section">
        <div class="container narrow">
          <div class="section-head">
            <h2>{t("preise.title")}</h2>
            <span class="divider" aria-hidden="true"></span>
            {
              SHOW_PRICES ? (
                <p>{t("preise.note")}</p>
              ) : (
                <p>
                  {t("preise.anfrageNote")} <a href={PHONE_LINK}><strong>{PHONE_DISPLAY}</strong></a>
                </p>
              )
            }
          </div>
          <table class="price-table">
            <thead>
              <tr>
                <th scope="col">{t("preise.colLeistung")}</th>
                <th scope="col">{t("preise.colPreis")}</th>
              </tr>
            </thead>
            <tbody>
              {
                prices.map((p) => (
                  <tr>
                    <td>
                      <span class="price-title">{p.title}</span>
                      <span class="price-text">{p.text}</span>
                    </td>
                    <td class="price">{p.price}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
          {SHOW_PRICES && <p class="price-hint">{t("preise.hint")}</p>}
        </div>
      </section>

      <!-- Vorher / Nachher -->
      <section id="galerie" class="section section-beige">
        <div class="container">
          <div class="section-head">
            <h2>{t("galerie.title")}</h2>
            <span class="divider" aria-hidden="true"></span>
          </div>
          <div class="ba-grid">
            {
              beforeAfter.map((ba) => (
                <figure class="ba">
                  <div class="ba-pair">
                    <div class="ba-item">
                      <Image src={ba.before} alt={ba.beforeAlt} class="ba-img" widths={[360, 640]} sizes="(max-width: 860px) 50vw, 25vw" loading="lazy" />
                      <span class="ba-tag">{t("galerie.vorher")}</span>
                    </div>
                    <div class="ba-item">
                      <Image src={ba.after} alt={ba.afterAlt} class="ba-img" widths={[360, 640]} sizes="(max-width: 860px) 50vw, 25vw" loading="lazy" />
                      <span class="ba-tag ba-tag-after">{t("galerie.nachher")}</span>
                    </div>
                  </div>
                  <figcaption>{ba.caption}</figcaption>
                </figure>
              ))
            }
          </div>
          <p class="center-action">
            <a class="btn btn-outline" href={INSTAGRAM} target="_blank" rel="noopener">{t("galerie.instagram")}</a>
          </p>
        </div>
      </section>

      <!-- Termin -->
      <section id="termin" class="section">
        <div class="container booking">
          <div class="section-head">
            <h2>{t("booking.title")}</h2>
            <span class="divider" aria-hidden="true"></span>
            <p>{t("booking.intro")} <a href={PHONE_LINK}><strong>{PHONE_DISPLAY}</strong></a> {t("booking.introSuffix")}</p>
          </div>
          <form class="booking-form" id="booking-form">
            <div class="field field-half">
              <label for="f-name">{t("booking.name")}</label>
              <input type="text" id="f-name" name="name" autocomplete="name" required />
            </div>
            <div class="field field-half">
              <label for="f-kontakt">{t("booking.kontakt")}</label>
              <input type="text" id="f-kontakt" name="kontakt" autocomplete="tel" required />
            </div>
            <div class="field">
              <label for="f-service">{t("booking.service")}</label>
              <select id="f-service" name="service" required>
                <option>{t("service.damen")}</option>
                <option>{t("service.herren")}</option>
                <option>{t("service.kinder")}</option>
                <option>{t("service.anlass")}</option>
                <option>{t("service.haus")}</option>
              </select>
            </div>
            <div class="field">
              <label for="f-person">{t("booking.person")}</label>
              <select id="f-person" name="person">
                <option>{t("booking.personEgal")}</option>
                <option>Kimberly</option>
                <option>Bianca</option>
              </select>
            </div>
            <div class="field">
              <label for="f-termin">{t("booking.termin")}</label>
              <input type="datetime-local" id="f-termin" name="wunschtermin" />
            </div>
            <div class="field field-wide">
              <label for="f-nachricht">{t("booking.nachricht")}</label>
              <textarea id="f-nachricht" name="nachricht" rows="4" placeholder={t("booking.nachrichtPlaceholder")}></textarea>
            </div>
            <div class="field-wide form-submit">
              <button type="submit" class="btn btn-solid">{t("booking.submit")}</button>
            </div>
          </form>
          <div id="booking-confirm" class="booking-confirm" hidden></div>
        </div>
      </section>

      <!-- Kontakt / Öffnungszeiten -->
      <section id="kontakt" class="section section-beige kontakt">
        <div class="container">
          <div class="section-head">
            <h2>{t("kontakt.title")}</h2>
            <span class="divider" aria-hidden="true"></span>
          </div>
          <div class="kontakt-grid">
            <div class="kontakt-col">
              <svg width="36" height="36" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"></path></svg>
              <h3>{t("kontakt.adresseTitle")}</h3>
              <p>Lindenweg 8<br />4711 Walhorn, {t("kontakt.land")}</p>
              <p class="small">{t("kontakt.parken")}</p>
              <a class="text-link" href="https://maps.google.com/?q=Lindenweg+8,+4711+Walhorn" target="_blank" rel="noopener">{t("kontakt.route")} →</a>
            </div>
            <div class="kontakt-col">
              <svg width="36" height="36" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"></path></svg>
              <h3>{t("kontakt.telefonTitle")}</h3>
              <p>
                <a href={PHONE_LINK}>{PHONE_DISPLAY}</a><br />
                <a href="mailto:kopfsache.info@gmail.com">kopfsache.info@gmail.com</a><br />
                <a href={INSTAGRAM} target="_blank" rel="noopener">@dasistalles.kopfsache</a>
              </p>
            </div>
            <div class="kontakt-col">
              <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
              <h3>{t("kontakt.zeitenTitle")}</h3>
              <dl class="hours">
                <dt>{t("kontakt.zeile1Tage")}</dt><dd>{t("kontakt.zeile1Zeit")}</dd>
                <dt>{t("kontakt.zeile2Tage")}</dt><dd>{t("kontakt.zeile2Zeit")}</dd>
                <dt class="closed">{t("kontakt.zeile3Tage")}</dt><dd class="closed">{t("kontakt.zeile3Zeit")}</dd>
              </dl>
              <p class="small">{t("kontakt.note")}</p>
            </div>
          </div>
          <Image src={salonEingang} alt={t("kontakt.imgAlt")} class="kontakt-img" widths={[480, 923]} sizes="(max-width: 760px) 100vw, 720px" loading="lazy" />
        </div>
      </section>
    </main>

    <Footer lang={lang} />
  </div>
</BaseLayout>

<style>
  section[id] {
    scroll-margin-top: 80px;
  }

  /* ---------- Bild oben ---------- */
  .hero {
    position: relative;
    background: var(--ink);
  }

  .hero-img {
    width: 100%;
    height: clamp(420px, 46vw, 600px);
    object-fit: cover;
    object-position: 30% 22%;
  }

  .hero-card {
    position: absolute;
    left: 50%;
    bottom: clamp(24px, 4vw, 48px);
    transform: translateX(-50%);
    width: min(560px, calc(100% - 2 * var(--gutter)));
    background: rgba(255, 255, 255, 0.96);
    padding: 32px 36px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-align: center;
  }

  .hero-card h1 {
    margin: 0;
    font-size: clamp(28px, 3.4vw, 36px);
    line-height: 1.2;
    letter-spacing: 0.01em;
  }

  .hero-card p {
    margin: 0;
    font-size: 16px;
    text-wrap: balance;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    padding-top: 4px;
  }

  @media (max-width: 640px) {
    .hero-img {
      height: 340px;
    }
    .hero-card {
      position: static;
      transform: none;
      width: auto;
      padding: 32px var(--gutter) 40px;
      background: var(--white);
    }
    .hero-actions {
      flex-direction: column;
      align-self: stretch;
    }
  }

  /* ---------- Über uns ---------- */
  .ueber {
    padding-top: var(--section-y);
  }

  .ueber-head {
    padding: 0 var(--gutter);
  }

  .ueber-split {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
  }

  .ueber-split > * {
    min-width: 0;
  }

  .ueber-img {
    width: 100%;
    max-width: 100%;
    height: 100%;
    min-height: 460px;
    object-fit: cover;
    object-position: 50% 35%;
  }

  .ueber-text {
    padding: clamp(40px, 5vw, 64px) clamp(24px, 5vw, 64px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    text-align: center;
  }

  .ueber-text p {
    margin: 0;
    max-width: 34em;
  }

  .scissors {
    color: var(--ink);
  }

  .sign {
    font-weight: 400;
    color: var(--gold-text);
  }

  .timeline {
    list-style: none;
    margin: 0 auto;
    padding: clamp(48px, 6vw, 64px) var(--gutter) var(--section-y);
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 24px;
    text-align: center;
  }

  .timeline li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 20px;
    border-top: 1px solid var(--gold);
  }

  .timeline .year {
    font-size: 28px;
    font-weight: 400;
    color: var(--gold-text);
    line-height: 1.2;
  }

  .timeline .label {
    font-size: 15px;
  }

  @media (max-width: 860px) {
    .ueber-split {
      grid-template-columns: minmax(0, 1fr);
    }
    .ueber-img {
      min-height: 0;
      height: auto;
      aspect-ratio: 3 / 2;
    }
    .timeline {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .timeline li:last-child {
      grid-column: 1 / -1;
    }
  }

  /* ---------- Team ---------- */
  .team-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }

  .team-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .team-img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    margin-bottom: 20px;
  }

  .team-card h3 {
    margin: 0 0 4px;
    font-size: 22px;
    color: var(--gold-text);
  }

  .team-card p {
    margin: 0;
    font-size: 15px;
  }

  @media (max-width: 860px) {
    .team-grid {
      grid-template-columns: minmax(0, 1fr);
      max-width: 420px;
      margin: 0 auto;
      gap: 48px;
    }
  }

  /* ---------- Leistungen ---------- */
  .service-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
  }

  .service-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    color: var(--ink);
  }
  .service-card:hover h3 {
    color: var(--ink);
  }

  .service-img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 50% 35%;
    margin-bottom: 24px;
  }

  .service-card h3 {
    margin: 0 0 12px;
    font-size: 24px;
    color: var(--gold-text);
    transition: color 160ms ease;
  }

  .more {
    font-size: 14px;
    color: var(--muted);
