<script>
  const hero = document.querySelector(".hero");
  const heroSlides = hero ? Array.from(hero.querySelectorAll(".hero-slide")) : [];
  const heroDots = hero ? Array.from(hero.querySelectorAll(".hero-dot")) : [];
  let heroIndex = 0;
  let heroTimer: number | undefined;
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function showSlide(n: number) {
    heroIndex = (n + heroSlides.length) % heroSlides.length;
    heroSlides.forEach((el, i) => el.classList.toggle("active", i === heroIndex));
    heroDots.forEach((el, i) => {
      el.classList.toggle("active", i === heroIndex);
      if (i === heroIndex) el.setAttribute("aria-current", "true");
      else el.removeAttribute("aria-current");
    });
  }

  function startHero() {
    if (reduceMotion || heroSlides.length < 2) return;
    stopHero();
    heroTimer = window.setInterval(() => showSlide(heroIndex + 1), 5000);
  }

  function stopHero() {
    if (heroTimer) window.clearInterval(heroTimer);
  }

  // Bilder 2-4 vorladen, sobald die Seite steht
  window.addEventListener("load", () => {
    heroSlides.slice(1).forEach((el) => ((el as HTMLImageElement).loading = "eager"));
    startHero();
  });

  heroDots.forEach((dot, i) =>
    dot.addEventListener("click", () => {
      showSlide(i);
      startHero();
    })
  );

  document.addEventListener("visibilitychange", () => (document.hidden ? stopHero() : startHero()));
</script>

<script define:vars={{ bookingVars }}>
  const form = document.getElementById("booking-form");
  const confirmEl = document.getElementById("booking-confirm");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();

    const data = new FormData(form);
    const name = String(data.get("name") || "").trim();
    const kontakt = String(data.get("kontakt") || "").trim();
    const service = String(data.get("service") || "");
    const person = String(data.get("person") || "");
    const wunschtermin = String(data.get("wunschtermin") || "");
    const nachricht = String(data.get("nachricht") || "").trim();

    const lines = [
      `${bookingVars.labelName}: ${name}`,
      `${bookingVars.labelKontakt}: ${kontakt}`,
      `${bookingVars.labelLeistung}: ${service}`,
      `${bookingVars.labelPerson}: ${person}`,
      `${bookingVars.labelTermin}: ${wunschtermin || bookingVars.flexibel}`,
      `${bookingVars.labelNachricht}: ${nachricht || bookingVars.keine}`,
    ];
    const body = lines.join("\n");
    const subject = `${bookingVars.subjectPrefix}: ${service}`;
    const mailto = `mailto:kopfsache.info@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

    if (confirmEl) {
      const safeName = (name || bookingVars.thanksFallbackName).replace(/[<>&"]/g, "");
      const thanks = bookingVars.thanksTemplate.replace("{name}", safeName);
      confirmEl.innerHTML = `
        <p>${thanks}</p>
        <p>${bookingVars.fallbackPrefix}<a href="${mailto}">${bookingVars.fallbackLink}</a>${bookingVars.fallbackSuffix}</p>
      `;
      confirmEl.hidden = false;
    }

    window.location.href = mailto;
    form.reset();
  });
</script>
