---
import { Image, getImage } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import salonInnen from "../assets/images/salon-innen.jpg";
import kimberlySalon from "../assets/images/kimberly-salon.jpg";
import teamKimberly from "../assets/images/team-kimberly.jpg";
import teamBianca from "../assets/images/team-bianca.jpg";
import teamLara from "../assets/images/team-lara.jpg";
import teamGruppe from "../assets/images/team-gruppe.jpg";
import leistungSchnitt from "../assets/images/leistung-schnitt.jpg";
import leistungFarbe from "../assets/images/leistung-farbe.jpg";
import glyntRegal from "../assets/images/glynt-regal.jpg";
import salonLampen from "../assets/images/salon-lampen.jpg";
import farbberatung from "../assets/images/farbberatung.jpg";
import salonSpiegel from "../assets/images/salon-spiegel.jpg";
import salonWaschplatz from "../assets/images/salon-waschplatz.jpg";
import salonEmpfang from "../assets/images/salon-empfang.jpg";
import hochEmpfang from "../assets/images/hoch-empfang.jpg";
import hochSpiegel from "../assets/images/hoch-spiegel.jpg";
import balayageVorher from "../assets/images/balayage-vorher.jpg";
import balayageNachher from "../assets/images/balayage-nachher.jpg";
import bobVorher from "../assets/images/bob-vorher.jpg";
import bobNachher2 from "../assets/images/bob-nachher2.jpg";
import { useTranslations, type Lang } from "../i18n/translations";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const PHONE_DISPLAY = "087 76 67 35";
const PHONE_LINK = "tel:+3287766735";
const INSTAGRAM = "https://www.instagram.com/dasistalles.kopfsache/";
const FACEBOOK = "https://www.facebook.com/Kopfsacheeupen/";
const WHATSAPP_DISPLAY = "0471 88 63 29";
const WHATSAPP = `https://wa.me/32471886329?text=${encodeURIComponent(t("whatsapp.text"))}`;

// Computer: Querformat-Bilder · Handy (bis 760 px): eigene Hochformat-Bilder
const slideDefs = [
  { desk: salonLampen, deskPos: "56% 45%", mob: hochEmpfang, mobPos: "50% 15%" },
  { desk: salonInnen, deskPos: "50% 60%", mob: teamKimberly, mobPos: "50% 22%" },
  { desk: kimberlySalon, deskPos: "68% 30%", mob: salonWaschplatz, mobPos: "50% 35%" },
  { desk: farbberatung, deskPos: "50% 45%", mob: hochSpiegel, mobPos: "50% 35%" },
];

const slides = await Promise.all(
  slideDefs.map(async (d) => {
    const desk = await getImage({ src: d.desk, widths: [1024, 1600, 2560], format: "webp" });
    const mob = await getImage({ src: d.mob, widths: [480, 800, 1200], format: "webp" });
    return { ...d, desk, mob };
  })
);

const heroFacts = [t("hero.fact1"), t("hero.fact2"), t("hero.fact3"), t("hero.fact4")];

const timeline = [
  { year: "2008", label: t("ueber.t1") },
  { year: "2014", label: t("ueber.t2") },
  { year: "2017", label: t("ueber.t3") },
  { year: "2020", label: t("ueber.t4") },
  { year: t("ueber.t5Year"), label: t("ueber.t5") },
];

const team = [
  { name: "Kimberly", role: t("team.kimberly.role"), img: teamKimberly, position: "50% 20%" },
  { name: "Bianca", role: t("team.bianca.role"), img: teamBianca, position: "50% 20%" },
  { name: "Lara", role: t("team.lara.role"), img: teamLara, position: "50% 20%" },
];

const extras = [
  { title: t("leistungen.herren"), text: t("leistungen.herrenText") },
  { title: t("leistungen.kinder"), text: t("leistungen.kinderText") },
  { title: t("leistungen.anlass"), text: t("leistungen.anlassText") },
  { title: t("leistungen.haus"), text: t("leistungen.hausText") },
];

/**
 * Preise vorübergehend ausgeblendet, bis Kimberly die finale Preisliste
 * bestätigt hat. Zum Wiedereinblenden einfach auf true setzen.
 */
const SHOW_PRICES = false;

const pricesAll = [
  { title: t("preise.damen"), text: t("preise.damenText"), price: t("preise.damenPreis") },
  { title: t("preise.herren"), text: t("preise.herrenText"), price: t("preise.herrenPreis") },
  { title: t("preise.kinder"), text: t("preise.kinderText"), price: t("preise.kinderPreis") },
  { title: t("preise.anlass"), text: t("preise.anlassText"), price: t("preise.aufAnfrage") },
  { title: t("preise.haus"), text: t("preise.hausText"), price: t("preise.aufAnfrage") },
];

const prices = SHOW_PRICES ? pricesAll : pricesAll.map((p) => ({ ...p, price: t("preise.aufAnfrage") }));

const beforeAfter = [
  {
    before: balayageVorher,
    after: balayageNachher,
    beforeAlt: t("galerie.cap1Vorher"),
    afterAlt: t("galerie.cap1Nachher"),
    caption: t("galerie.cap1"),
  },
  {
    before: bobVorher,
    after: bobNachher2,
    beforeAlt: t("galerie.cap2Vorher"),
    afterAlt: t("galerie.cap2Nachher"),
    caption: t("galerie.cap2"),
  },
];

// Damit Google „Kopfsache“ statt der Adresse als Seitennamen zeigt
const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Kopfsache",
  alternateName: ["Kopfsache Walhorn", "Friseur Kopfsache Walhorn"],
  url: "https://kopfsache-walhorn.be/",
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "HairSalon",
  name: "Kopfsache",
  url: "https://kopfsache-walhorn.be/",
  image: "https://kopfsache-walhorn.be/og-image.jpg",
  logo: "https://kopfsache-walhorn.be/favicon-512.png",
  priceRange: "€€",
  telephone: "+32 87 76 67 35",
  email: "kopfsache.info@gmail.com",
  founder: { "@type": "Person", name: "Kimberly Bonni" },
  address: {
    "@type": "PostalAddress",
    streetAddress: "Lindenweg 8",
    postalCode: "4711",
    addressLocality: "Walhorn",
    addressCountry: "BE",
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "09:00",
      closes: "18:00",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: "Saturday",
      opens: "08:00",
      closes: "14:00",
    },
  ],
  sameAs: [INSTAGRAM, FACEBOOK],
};

const alternates = [
  { hreflang: "de", href: "https://kopfsache-walhorn.be/" },
  { hreflang: "fr", href: "https://kopfsache-walhorn.be/fr/" },
  { hreflang: "x-default", href: "https://kopfsache-walhorn.be/" },
];

const bookingVars = {
  subjectPrefix: t("booking.mailSubject"),
  labelName: t("booking.mailName"),
  labelKontakt: t("booking.mailKontakt"),
  labelLeistung: t("booking.mailLeistung"),
  labelPerson: t("booking.mailPerson"),
  labelTermin: t("booking.mailTermin"),
  flexibel: t("booking.mailFlexibel"),
  labelNachricht: t("booking.mailNachricht"),
  keine: t("booking.mailKeine"),
  thanksTemplate: t("booking.thanks"),
  thanksFallbackName: t("booking.thanksFallbackName"),
  fallbackPrefix: t("booking.fallbackPrefix"),
  fallbackLink: t("booking.fallbackLink"),
  fallbackSuffix: t("booking.fallbackSuffix"),
};
---

<BaseLayout title={t("meta.title")} description={t("meta.description")} lang={lang} alternates={alternates}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />

  <div id="top">
    <Header lang={lang} />

    <main>
      <!-- Bild oben: großes Bild mit Bildwechsel -->
      <section class="hero" aria-roledescription="carousel" aria-label={t("hero.carouselLabel")}>
        <div class="hero-slides">
          {
            slides.map((sl, i) => (
              <picture>
                <source media="(max-width: 760px)" srcset={sl.mob.srcSet.attribute} sizes="100vw" type="image/webp" />
                <img
                  src={sl.desk.src}
                  srcset={sl.desk.srcSet.attribute}
                  sizes="100vw"
                  alt={i === 0 ? t("hero.imgAlt") : ""}
                  aria-hidden={i === 0 ? undefined : "true"}
                  class:list={["hero-slide", { active: i === 0 }]}
                  loading={i === 0 ? "eager" : "lazy"}
                  fetchpriority={i === 0 ? "high" : "auto"}
                  decoding="async"
                  style={`--pos:${sl.deskPos};--pos-m:${sl.mobPos}`}
                  data-slide={i}
                />
              </picture>
            ))
          }
        </div>
        <div class="hero-shade" aria-hidden="true"></div>
        <div class="hero-content">
          <p class="hero-kicker">KOPFSACHE · WALHORN</p>
          <h1>{t("hero.title")}</h1>
          <div class="hero-actions">
            <a class="btn btn-solid" href="#termin">{t("booking.title")}</a>
            <a class="btn btn-light" href={PHONE_LINK}>{PHONE_DISPLAY}</a>
            <a class="btn btn-light btn-icon" href={WHATSAPP} target="_blank" rel="noopener"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 20.5l1.4-4.1A8.6 8.6 0 1 1 8.3 19.3z"></path><path d="M9 8.6c.2-.5.6-.6.9-.6h.5c.2 0 .4.1.5.4l.6 1.5c.1.2 0 .5-.1.6l-.5.6c.6 1.2 1.5 2.1 2.7 2.7l.6-.5c.2-.2.4-.2.6-.1l1.5.6c.3.1.4.3.4.5v.5c0 .3-.1.7-.6.9-.6.3-1.7.4-3.5-.7-1.6-1-2.7-2.4-3.3-3.6-.5-1.1-.5-2.2-.2-2.7z" fill="currentColor" stroke="none"></path></svg>WhatsApp</a>
          </div>
          <ul class="hero-facts">
            {heroFacts.map((f) => <li>{f}</li>)}
          </ul>
        </div>
        <div class="hero-dots">
          {
            slides.map((_, i) => (
              <button type="button" class:list={["hero-dot", { active: i === 0 }]} data-dot={i} aria-label={`${t("hero.slideLabel")} ${i + 1}`} aria-current={i === 0 ? "true" : undefined}></button>
            ))
          }
        </div>
      </section>

      <!-- Über uns -->
      <section id="ueber" class="section-beige ueber">
        <div class="section-head ueber-head">
          <h2>{t("ueber.title")}</h2>
          <span class="divider" aria-hidden="true"></span>
        </div>
        <div class="ueber-split">
          <Image
            src={kimberlySalon}
            alt={t("ueber.imgAlt")}
            class="ueber-img"
            widths={[640, 1024, 1600]}
            sizes="(max-width: 860px) 100vw, 50vw"
            loading="lazy"
          />
          <div class="ueber-text">
            <svg class="scissors" width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" aria-hidden="true">
              <circle cx="6" cy="6" r="3"></circle>
              <circle cx="6" cy="18" r="3"></circle>
              <line x1="20" y1="4" x2="8.12" y2="15.88"></line>
              <line x1="14.47" y1="14.48" x2="20" y2="20"></line>
              <line x1="8.12" y1="8.12" x2="12" y2="12"></line>
            </svg>
            <p>{t("ueber.p1")}</p>
            <p>{t("ueber.p2")}</p>
            <p class="sign">{t("ueber.sign")}</p>
          </div>
        </div>
        <ol class="timeline container" aria-label={t("ueber.timelineLabel")}>
          {
            timeline.map((step) => (
              <li>
                <span class="year">{step.year}</span>
                <span class="label">{step.label}</span>
              </li>
            ))
          }
        </ol>
      </section>

      <!-- Team -->
      <section id="team" class="section">
        <div class="container">
          <div class="section-head">
            <h2>{t("team.title")}</h2>
            <span class="divider" aria-hidden="true"></span>
          </div>
          <ul class="team-grid">
            {
              team.map((m) => (
                <li class="team-card">
                  <Image
                    src={m.img}
                    alt={m.name}
                    class="team-img"
                    widths={[360, 600]}
                    sizes="(max-width: 860px) 100vw, 33vw"
                    loading="lazy"
                    style={`object-position:${m.position}`}
                  />
                  <h3>{m.name}</h3>
                  <p>{m.role}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- Leistungen -->
      <section id="leistungen" class="section section-beige">
        <div class="container">
          <div class="section-head">
            <h2>{t("leistungen.title")}</h2>
            <span class="divider" aria-hidden="true"></span>
          </div>
          <div class="service-grid">
            <a class="service-card" href="#preise">
              <Image src={leistungSchnitt} alt={t("leistungen.schnittAlt")} class="service-img" widths={[640, 1100]} sizes="(max-width: 700px) 100vw, 50vw" loading="lazy" />
              <h3>{t("leistungen.schnitt")}</h3>
              <span class="more">{t("leistungen.more")}</span>
            </a>
            <a class="service-card" href="#preise">
              <Image src={leistungFarbe} alt={t("leistungen.farbeAlt")} class="service-img" widths={[640, 1100]} sizes="(max-width: 700px) 100vw, 50vw" loading="lazy" />
              <h3>{t("leistungen.farbe")}</h3>
              <span class="more">{t("leistungen.more")}</span>
            </a>
          </div>
          <ul class="extras">
            {
              extras.map((e) => (
                <li>
                  <h3>{e.title}</h3>
                  <p>{e.text}</p>
                </li>
              ))
            }
          </ul>
          <div class="glynt">
            <Image src={glyntRegal} alt={t("glynt.imgAlt")} class="glynt-img" widths={[640, 1100]} sizes="(max-width: 760px) 100vw, 560px" loading="lazy" />
            <div class="glynt-text">
              <h3>GLYNT</h3>
              <p>{t("glynt.text")} <strong>GLYNT</strong>.</p>
              <p class="small">{t("glynt.sub")}</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Unser Salon -->
      <section id="salon" class="section">
        <div class="container">
          <div class="section-head">
            <h2>{t("salon.title")}</h2>
            <span class="divider" aria-hidden="true"></span>
            <p>{t("salon.text")}</p>
          </div>
          <div class="salon-grid">
            <Image src={salonLampen} alt={t("salon.img1")} class="salon-img salon-big" widths={[640, 1100, 1600]} sizes="(max-width: 760px) 100vw, 560px" loading="lazy" />
            <Image src={salonSpiegel} alt={t("salon.img2")} class="salon-img salon-wide" widths={[640, 1100, 1600]} sizes="(max-width: 760px) 100vw, 560px" loading="lazy" />
            <Image src={salonWaschplatz} alt={t("salon.img3")} class="salon-img" widths={[480, 800]} sizes="(max-width: 760px) 50vw, 280px" loading="lazy" style="object-position:50% 45%" />
            <Image src={salonEmpfang} alt={t("salon.img4")} class="salon-img" widths={[480, 800]} sizes="(max-width: 760px) 50vw, 280px" loading="lazy" style="object-position:72% 50%" />
          </div>
        </div>
      </section>

      <!-- Preise -->
      <section id="preise" class="section">
        <div class="container narrow">
          <div class="section-head">
            <h2>{t("preise.title")}</h2>
            <span class="divider" aria-hidden="true"></span>
            {
              SHOW_PRICES ? (
                <p>{t("preise.note")}</p>
              ) : (
                <p>
                  {t("preise.anfrageNote")} <a href={PHONE_LINK}><strong>{PHONE_DISPLAY}</strong></a>
                </p>
              )
            }
          </div>
          <table class="price-table">
            <thead>
              <tr>
                <th scope="col">{t("preise.colLeistung")}</th>
                <th scope="col">{t("preise.colPreis")}</th>
              </tr>
            </thead>
            <tbody>
              {
                prices.map((p) => (
                  <tr>
                    <td>
                      <span class="price-title">{p.title}</span>
                      <span class="price-text">{p.text}</span>
                    </td>
                    <td class="price">{p.price}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
          {SHOW_PRICES && <p class="price-hint">{t("preise.hint")}</p>}
        </div>
      </section>

      <!-- Vorher / Nachher -->
      <section id="galerie" class="section section-beige">
        <div class="container">
          <div class="section-head">
            <h2>{t("galerie.title")}</h2>
            <span class="divider" aria-hidden="true"></span>
          </div>
          <div class="ba-grid">
            {
              beforeAfter.map((ba) => (
                <figure class="ba">
                  <div class="ba-pair">
                    <div class="ba-item">
                      <Image src={ba.before} alt={ba.beforeAlt} class="ba-img" widths={[360, 640]} sizes="(max-width: 860px) 50vw, 25vw" loading="lazy" />
                      <span class="ba-tag">{t("galerie.vorher")}</span>
                    </div>
                    <div class="ba-item">
                      <Image src={ba.after} alt={ba.afterAlt} class="ba-img" widths={[360, 640]} sizes="(max-width: 860px) 50vw, 25vw" loading="lazy" />
                      <span class="ba-tag ba-tag-after">{t("galerie.nachher")}</span>
                    </div>
                  </div>
                  <figcaption>{ba.caption}</figcaption>
                </figure>
              ))
            }
          </div>
          <p class="center-action">
            <a class="btn btn-outline" href={INSTAGRAM} target="_blank" rel="noopener">{t("galerie.instagram")}</a>
          </p>
        </div>
      </section>

      <!-- Termin -->
      <section id="termin" class="section">
        <div class="container booking">
          <div class="section-head">
            <h2>{t("booking.title")}</h2>
            <span class="divider" aria-hidden="true"></span>
            <p>{t("booking.intro")} <a href={PHONE_LINK}><strong>{PHONE_DISPLAY}</strong></a>, {t("booking.introWhatsapp")} <a href={WHATSAPP} target="_blank" rel="noopener"><strong>WhatsApp</strong></a> {t("booking.introSuffix")}</p>
          </div>
          <form class="booking-form" id="booking-form">
            <div class="field field-half">
              <label for="f-name">{t("booking.name")}</label>
              <input type="text" id="f-name" name="name" autocomplete="name" required />
            </div>
            <div class="field field-half">
              <label for="f-kontakt">{t("booking.kontakt")}</label>
              <input type="text" id="f-kontakt" name="kontakt" autocomplete="tel" required />
            </div>
            <div class="field">
              <label for="f-service">{t("booking.service")}</label>
              <select id="f-service" name="service" required>
                <option>{t("service.damen")}</option>
                <option>{t("service.herren")}</option>
                <option>{t("service.kinder")}</option>
                <option>{t("service.anlass")}</option>
                <option>{t("service.haus")}</option>
              </select>
            </div>
            <div class="field">
              <label for="f-person">{t("booking.person")}</label>
              <select id="f-person" name="person">
                <option>{t("booking.personEgal")}</option>
                <option>Kimberly</option>
                <option>Bianca</option>
              </select>
            </div>
            <div class="field">
              <label for="f-termin">{t("booking.termin")}</label>
              <input type="datetime-local" id="f-termin" name="wunschtermin" />
            </div>
            <div class="field field-wide">
              <label for="f-nachricht">{t("booking.nachricht")}</label>
              <textarea id="f-nachricht" name="nachricht" rows="4" placeholder={t("booking.nachrichtPlaceholder")}></textarea>
            </div>
            <div class="field-wide form-submit">
              <button type="submit" class="btn btn-solid">{t("booking.submit")}</button>
            </div>
          </form>
          <div id="booking-confirm" class="booking-confirm" hidden></div>
        </div>
      </section>

      <!-- Kontakt / Öffnungszeiten -->
      <section id="kontakt" class="section section-beige kontakt">
        <div class="container">
          <div class="section-head">
            <h2>{t("kontakt.title")}</h2>
            <span class="divider" aria-hidden="true"></span>
          </div>
          <div class="kontakt-grid">
            <div class="kontakt-col">
              <svg width="36" height="36" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"></path></svg>
              <h3>{t("kontakt.adresseTitle")}</h3>
              <p>Lindenweg 8<br />4711 Walhorn, {t("kontakt.land")}</p>
              <p class="small">{t("kontakt.parken")}</p>
              <a class="text-link" href="https://maps.google.com/?q=Lindenweg+8,+4711+Walhorn" target="_blank" rel="noopener">{t("kontakt.route")} →</a>
            </div>
            <div class="kontakt-col">
              <svg width="36" height="36" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"></path></svg>
              <h3>{t("kontakt.telefonTitle")}</h3>
              <p>
                <a href={PHONE_LINK}>{PHONE_DISPLAY}</a><br />
                <a href={WHATSAPP} target="_blank" rel="noopener">WhatsApp: {WHATSAPP_DISPLAY}</a><br />
                <a href="mailto:kopfsache.info@gmail.com">kopfsache.info@gmail.com</a>
              </p>
              <p class="small">{t("kontakt.folgen")}</p>
              <div class="kontakt-social">
                <a href={INSTAGRAM} target="_blank" rel="noopener" aria-label="Instagram"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle></svg></a>
